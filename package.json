{
  "name": "sustally-brsr-agent",
  "version": "1.0.0",
  "description": "BRSR/ESG sustainability analyst with Ollama tool-calling agent",
  "type": "module",
  "scripts": {
    "preprocess": "node agent/scripts/preprocess.js",
    "migrate:postgres": "node agent/scripts/migrate_sqlite_to_postgres.js",
    "enrich:sources": "node agent/scripts/enrich_report_sources.js --with-pages",
    "download-reports": "node agent/scripts/download_nse_reports.js",
    "upload:r2": "node agent/scripts/upload_pdfs_to_r2.js",
    "upload:hf": "node agent/scripts/upload_pdfs_to_hf.js",
    "install-browser": "npx puppeteer browsers install chrome",
    "report-counts": "node agent/scripts/report_counts.js",
    "evaluate": "node agent/scripts/evaluate_agent.js",
    "evaluate:top15": "node agent/scripts/top15_important_questions.js",
    "evaluate:top15:run": "node agent/scripts/top15_important_questions.js --run",
    "evaluate:judge": "node agent/scripts/evaluate_with_judge.js",
    "compare:models": "node agent/scripts/compare_models.js",
    "compare:gpt-deepseek": "node agent/scripts/compare_gpt_deepseek.js --fast",
    "test:citations": "node agent/scripts/test_citations.js",
    "test:all": "node agent/scripts/run_all_tests.js",
    "test:all:quick": "node agent/scripts/run_all_tests.js --quick",
    "verify:pdf-sources": "node agent/scripts/verify_pdf_sources.js",
    "dev": "node agent/src/server.js",
    "ui": "node agent/src/server.js",
    "start": "node agent/src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@huggingface/hub": "^2.13.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "firebase-admin": "^14.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "puppeteer": "^25.1.0",
    "sql.js": "^1.14.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "jose": "5.9.6"
  }
}
