# Firebase Authentication (https://console.firebase.google.com)
# Web app config — Project settings → Your apps → SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Service account JSON (Project settings → Service accounts → Generate new private key)
# Paste the full JSON on one line, or use a path via GOOGLE_APPLICATION_CREDENTIALS locally
FIREBASE_SERVICE_ACCOUNT=

# Session signing secret for httpOnly cookies
SESSION_SECRET=

# Port for the Ollama agent web server
PORT=3000

# Neon Postgres — when set, the app uses this instead of local SQLite
# Create at https://console.neon.tech → Connection string
DATABASE_URL=

# SQLite database (used when DATABASE_URL is empty; built by npm run preprocess)
DB_PATH=data/database.db

# BRSR/ESG XBRL reports (year/symbol folders)
XBRL_DIR=data/xbrl

# BRSR PDF attachments (year/symbol folders; download only, not parsed)
PDF_DIR=data/pdf

# Hugging Face Hub — preferred free public PDF hosting for deployed source links
# Token: https://huggingface.co/settings/tokens (Write access)
# Repo will be created as a public dataset if missing
HF_TOKEN=
HF_DATASET_REPO=your-username/sustally-brsr-pdfs
# Upload tuning (stay under HF free ~128 commits/hour by batching files)
# HF_UPLOAD_BATCH_SIZE=40
# HF_UPLOAD_BATCH_MAX_MB=250
# Optional: PDF_HF_MAP_PATH=data/pdf_hf_urls.json

# Cloudflare R2 — optional alternate hosting (requires card for enablement)
# Create bucket + API token: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sustally-brsr-pdfs
# Public base from R2 bucket → Settings → Public development URL (or custom domain)
R2_PUBLIC_BASE_URL=
# Optional: path to committed URL map (default data/pdf_r2_urls.json)
# PDF_R2_MAP_PATH=data/pdf_r2_urls.json
# R2_UPLOAD_CONCURRENCY=4

# NSE sustainability metadata index
METADATA_PATH=data/nse_sustainability_metadata.json

# OpenAI — FIXED primary model when OPENAI_API_KEY is set (preferred for local + Vercel).
# https://platform.openai.com/api-keys
# With this key set, the app always uses OPENAI_MODEL (client cannot switch to Qwen/Ollama).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_WARMUP=true

# OpenRouter — only used if OPENAI_API_KEY is empty
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct,qwen/qwen-2.5-7b-instruct
# OPENROUTER_WARMUP=true
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=SusTally BRSR Agent

# Ollama — used only when BOTH OpenAI and OpenRouter keys are empty (local free fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.15
OLLAMA_TIMEOUT_MS=90000

# Model evaluation (npm run evaluate:judge)
# JUDGE_MODEL=gpt-4o-mini

# Agent limits (lower = faster; raise history for follow-up list pagination)
AGENT_MAX_ITERATIONS=5
AGENT_MAX_HISTORY=8
AGENT_SQL_ROW_LIMIT=15
# Longer completion budget for the final answer turn (tool turns keep OLLAMA_NUM_PREDICT)
AGENT_FINAL_NUM_PREDICT=2048

# Phase 1 intent extraction — LLM returns structured JSON only; rules remain fallback
# INTENT_LLM_ENABLED=true          # default: on when a provider key/host exists; set false for offline tests
# INTENT_LLM_MIN_CONFIDENCE=0.55
# INTENT_LLM_TIMEOUT_MS=12000

# Phase 5/6 plan validation — reject incoherent plans before SQL/RAG runs
# PLAN_MIN_CONFIDENCE=0.45
# PLAN_MIN_SCORE=0.4

# Phase 8 — confidence-based retrieval ladder (SQL → Narrative → PDF)
# RETRIEVAL_MIN_CONFIDENCE=0.45

# Phase 13 — optional small planning model (JSON-only; rules remain fallback)
# PLANNING_MODEL_ENABLED=false
# PLANNING_MODEL=gpt-4o-mini
# PLANNING_MODEL_MIN_CONFIDENCE=0.6
# PLANNING_MODEL_TIMEOUT_MS=10000

# Phase 15 — LangGraph orchestration (same stages; falls back to imperative if package missing)
# Stable path (recommended): Execution Planner + imperative pipeline. Keep LangGraph off unless debugging.
USE_LANGGRAPH=false
# Set true only to try LangGraph orchestration of the same stages.
# Requires optionalDependency: npm i  (installs @langchain/langgraph when available)

# Execution Planner — single routing authority (ExecutionPlan → Orchestrator → Engines).
# Default: enabled. Set USE_EXECUTION_PLANNER=false to force legacy Tool/Capability/Router path.
USE_EXECUTION_PLANNER=true
# EXECUTION_PLAN_COMPARE=true   # log MATCH/DIFF vs legacy planners (default: true)
# EXECUTION_ENGINE_TIMEOUT_MS=45000

# SQL → company-scoped document fallback (narrative/data_json → single company PDF)
# Default: enabled. Set false to keep legacy "metric unavailable" / LLM handoff after SQL miss.
# Never applies to rankings, Top-N, sector summaries, or aggregate analytics.
SQL_DOCUMENT_FALLBACK=true
# Max companies in one document-fallback turn (default 3, hard cap 20)
# Either name is accepted:
SQL_DOCUMENT_FALLBACK_MAX_COMPANIES=3
# MAX_DOCUMENT_FALLBACK_COMPANIES=3

# Database resilience (Neon → optional local SQLite fallback)
# ALLOW_SQLITE_FALLBACK=true   # default true locally; set false to fail hard if Neon is down
# DB_RETRY_COUNT=3
# DB_RETRY_DELAY_MS=250

# Unified answer validation (Phase 1) — runs after engines, before final return
# UNIFIED_ANSWER_VALIDATION=false  # default on; set false to bypass the gate (rollback)

# Phase 6 — Shared framework / concept registry (BRSR, ISSB, GRI, …)
# Default: enabled. Set false to use legacy inline glossary/framework arrays.
# USE_FRAMEWORK_REGISTRY=false

# Production Readiness Part 1 — CI / evaluation quality gates (merge-blocking)
# npm run ci                 # local: test + smoke + plan-ci + category summary
# npm run evaluate:smoke     # plan smoke, default min pass rate 100%
# npm run evaluate:ci        # plan all cases, default min pass rate 95%
# npm run ci:summary         # category pass rates (incl. recommendation/charts/memory)
# npm run evaluate:pipeline  # optional; only fails when EVAL_PIPELINE_GATE=true
# GitHub Actions: .github/workflows/ci.yml
#   - Required check for deploy: "Deploy gate (quality gates passed)"
#   - Enable in GitHub branch protection + Vercel "Ignored Build Step" / required checks
# EVAL_SMOKE_MIN_PASS_RATE=1
# EVAL_PLAN_CI_MIN_PASS_RATE=0.95
# EVAL_TEST_SMOKE_MIN_PASS_RATE=0.95
# EVAL_PIPELINE_GATE=false
# EVAL_PIPELINE_MIN_PASS_RATE=0.90
# EVAL_FAIL_ON_ERROR=false
#
# Final Acceptance Testing (after Parts 1–5) — not part of PR CI
# npm run acceptance              # plan-mode ~170 cases, default min 95%
# ACCEPTANCE_CONFIRM=yes npm run acceptance:http   # live /api/chat on staging
# ACCEPTANCE_MIN_PASS_RATE=0.95
# Reports: data/evaluation_reports/acceptance-*.json

# Production Readiness Part 3 — Reliability
# Probes: GET /healthz (liveness), GET /readyz (DB ready)
# CHAT_RATE_LIMIT_RPM=60          # token bucket per IP/session; set 0 to disable
# EXECUTION_ENGINE_TIMEOUT_MS=45000
# Soft-fail: recommendation/guidance/document timeouts omit that section;
# analytics/report answers still return when recommendation fails.

# Production Readiness Part 2 — Monitoring dashboard
# UI: /ops  ·  API: GET /api/monitoring (auth required in production)
# MONITORING_TOKEN=               # Bearer or x-monitoring-token (preferred in prod)
# SLOW_REQUEST_MS=5000            # mark / list slow requests
# MONITORING_RECENT_RING=50
# MONITORING_SLOWEST_LIMIT=10
# Without MONITORING_TOKEN: Firebase session required if auth configured;
# local/dev allows open access; Vercel/production requires token or session.

# Production Readiness Part 5 — Documentation
# README.md · docs/ARCHITECTURE.md · docs/OPERATIONS.md · docs/DEPLOYMENT.md · docs/TESTING.md
# Flag source of truth remains this file (.env.example).

# Production Readiness Part 4 — Load / stress testing (not in PR CI)
# npm run load-test                 # plan-mode concurrent planner (safe default)
# npm run load-test:conversation    # long follow-up pack
# npm run load-test:http            # hits live /api/chat — requires confirm
# LOAD_TEST_CONFIRM=yes             # required for http mode
# LOAD_TEST_BASE_URL=http://127.0.0.1:3000
# LOAD_TEST_TIMEOUT_MS=120000
# Reports: data/evaluation_reports/load-*.json (gitignored)
# Tip: raise CHAT_RATE_LIMIT_RPM for http load tests, or set 0 to disable.

# Phase 4 — Performance (no business-logic change)
# SQL_CACHE_ENABLED=false           # default on; set false to disable company-list/identity/sector caches
# SQL_CACHE_TTL_MS=300000           # 5 minutes
# RANKING_CACHE_ENABLED=false       # reserved / opt-in (not enabled by default)
# PDF_FETCH_TIMEOUT_MS=15000        # bounds previously unbounded PDF downloads
# ASYNC_LOGGING=false               # default sync appendFileSync; set true to buffer+flush
# ASYNC_LOG_FLUSH_MS=2000
# EXECUTION_ENGINE_TIMEOUT_MS=45000 # was 120000
# OLLAMA_TIMEOUT_MS=90000           # was 120000-180000

# PDF / citation performance (defaults favor response speed)
# VERIFY_CITATIONS=false          # skip all post-answer PDF checks
# VERIFY_FULL_SOURCE_CITATIONS=true  # audit every metric on every source PDF (slow; used in tests)
PDF_INDEX_CONCURRENCY=3
PDF_PAGE_TEXT_CACHE_MAX=50
MIN_METRIC_PAGE_SCORE=18
MAX_STORED_CHATS=200

# NSE BRSR report downloader
NSE_DOWNLOAD_LIMIT=20
NSE_FROM_DATE=01-01-2020
NSE_DOWNLOAD_DELAY_MS=750

# Optional: path to Chrome if Puppeteer cannot find it
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
