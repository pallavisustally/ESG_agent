# Port for the Ollama agent web server
PORT=3000

# SQLite database (built by npm run preprocess)
DB_PATH=data/database.db

# BRSR/ESG XBRL reports (year/symbol folders)
XBRL_DIR=data/xbrl

# NSE sustainability metadata index
METADATA_PATH=data/nse_sustainability_metadata.json

# OpenAI — preferred when OPENAI_API_KEY is set (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_WARMUP=true

# OpenRouter — set OPENROUTER_API_KEY to use cloud models instead of local Ollama
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.1-8b-instruct,qwen/qwen-2.5-7b-instruct
# OPENROUTER_WARMUP=true
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=SusTally BRSR Agent

# Ollama — speed tuning (used when no cloud API key is set)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.15
OLLAMA_TIMEOUT_MS=120000

# Model evaluation (npm run evaluate:judge)
# JUDGE_MODEL=gpt-4o-mini

# Agent limits (lower = faster)
AGENT_MAX_ITERATIONS=3
AGENT_MAX_HISTORY=4
AGENT_SQL_ROW_LIMIT=15

# NSE BRSR report downloader
NSE_DOWNLOAD_LIMIT=20
NSE_FROM_DATE=01-01-2020
NSE_DOWNLOAD_DELAY_MS=750

# Optional: path to Chrome if Puppeteer cannot find it
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
